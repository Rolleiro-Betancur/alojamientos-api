# ==================================================================
# APLICACION
# ==================================================================

# Clave secreta para firmar tokens JWT.
# Generar con: python scripts/generate_secret.py
SECRET_KEY=

# CORS: origenes permitidos (separados por comas).
# - En DESARROLLO: dejar vacio para permitir localhost:3000, 5173, etc.
# - En PRODUCCION: definir explicitamente. NUNCA usar '*'.
CORS_ALLOWED_ORIGINS=

# Expiracion del token JWT en minutos
JWT_EXP_MINUTES=15

# ==================================================================
# BASE DE DATOS (MySQL)
# ==================================================================
# Estas variables se usan tanto para:
#   - Crear la base de datos (scripts/create_db.py)
#   - Configurar la conexion de la app (app/config.py)
# La app construye internamente SQLALCHEMY_DATABASE_URI a partir de ellas.
# ==================================================================

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alojamientos_db
DB_CHARSET=utf8mb4
